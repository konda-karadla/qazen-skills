# Copy values into repo-root .env for local dev. Never commit real secrets.

# Postgres (matches infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qazen
POSTGRES_USER=qazen
POSTGRES_PASSWORD=qazen_local_dev
DATABASE_URL=postgresql://qazen:qazen_local_dev@localhost:5432/qazen

# MinIO (matches infra/docker-compose.yml)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=qazen
MINIO_SECRET_KEY=qazen_local_dev
MINIO_BUCKET=qa-runs
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# LLM — use LLM_PROFILE to switch backends
#   ollama  → Ollama local or :cloud models (OpenAI-compatible → :11434)
#   gemini  → Google Gemini Flash (free AI Studio key)
#   mistral → Mistral Cloud backup (set MISTRAL_API_KEY; LLM_PROFILE=mistral)
#   groq    → Groq Cloud (fast; free TPM is tight for QAZen prompts)
#   openai  → paid OpenAI (set OPENAI_API_KEY; restart gateway)
#   mock    → fixtures (or set LLM_PROVIDER=mock in process env for tests/CI)
# Explicit OPENAI_* values override profile defaults. LLM_PROVIDER=mock always wins.
# Do not set OPENAI_BASE_URL / OPENAI_MODEL unless you intend to override the profile.
# ---------------------------------------------------------------------------
LLM_PROFILE=gemini
LLM_PROVIDER=openai
AI_PROVIDER=openai

# Gemini (LLM_PROFILE=gemini) — get a key at https://aistudio.google.com/apikey
OPENAI_API_KEY=
# If gemini-3.6-flash 404s on your project, set the Flash id from AI Studio:
# OPENAI_MODEL=gemini-3.8-flash
OPENAI_TEMPERATURE=0
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=120

# Orchestrator → gateway HTTP timeout
LLM_GATEWAY_TIMEOUT_SECONDS=120

# Ollama (local qwen2.5:7b or Ollama Cloud :cloud models):
# LLM_PROFILE=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=nemotron-3-super:cloud
# LLM_GATEWAY_TIMEOUT_SECONDS=600
# OPENAI_TIMEOUT_SECONDS=600

# Paid OpenAI:
# LLM_PROFILE=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Mistral backup (Gemini stays live unless you set LLM_PROFILE=mistral):
# LLM_PROFILE=mistral
MISTRAL_API_KEY=

# Groq:
# LLM_PROFILE=groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-oss-20b

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# S6 execution: playwright (real browser) or mock (gateway fixture)
S6_EXECUTION_MODE=playwright

# Ports
REVIEW_API_PORT=8001
LLM_GATEWAY_PORT=8000
