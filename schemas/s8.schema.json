{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qazen.local/schemas/s8.schema.json",
  "title": "S8SecurityBoundaryScanOutput",
  "description": "Deterministic policy-engine scan of S5/S6 actions against security boundaries.",
  "type": "object",
  "required": ["run_id", "violations", "clean_confirmation"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "source", "severity", "routing_target", "detail"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string" },
          "source": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["deny", "escalate"]
          },
          "routing_target": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "clean_confirmation": {
      "type": "string",
      "description": "Explicit clean statement when violations is empty; empty string when violations exist."
    }
  }
}
