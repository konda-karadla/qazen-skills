{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qazen.local/schemas/s6.schema.json",
  "title": "S6ExecutionOrchestrationOutput",
  "description": "Execution results produced by S6, feeding S7/S8/S9.",
  "type": "object",
  "required": ["run_id", "correlation_id", "results", "evidence_manifest", "environment_metadata", "retry_log"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_case_id", "script_id", "status"],
        "additionalProperties": false,
        "properties": {
          "test_case_id": { "type": "string", "pattern": "^TC-[A-Za-z0-9_-]+$" },
          "script_id": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "evidence_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_case_id", "artifact_type", "storage_uri"],
        "additionalProperties": false,
        "properties": {
          "test_case_id": { "type": "string" },
          "artifact_type": {
            "type": "string",
            "enum": ["screenshot", "video", "trace", "har", "console_log", "network_log", "request_response"]
          },
          "storage_uri": { "type": "string" }
        }
      }
    },
    "environment_metadata": {
      "type": "object",
      "required": ["browser_version", "os", "runtime_version", "app_build", "api_schema_version", "viewport"],
      "additionalProperties": true,
      "properties": {
        "browser_version": { "type": "string" },
        "os": { "type": "string" },
        "runtime_version": { "type": "string" },
        "app_build": { "type": "string" },
        "api_schema_version": { "type": "string" },
        "viewport": { "type": "string" }
      }
    },
    "retry_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_case_id", "attempts"],
        "additionalProperties": false,
        "properties": {
          "test_case_id": { "type": "string" },
          "attempts": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
